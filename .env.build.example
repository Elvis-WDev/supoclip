# Build-time settings for scripts/ghcr-publish.sh. Copy to .env.build.
# NEXT_PUBLIC_* values are baked into the frontend image, so rebuild the
# frontend whenever they change. Runtime secrets belong in Dokploy, not here.

GHCR_OWNER=elvis-wdev
# Architecture of the Dokploy server (uname -m: aarch64 -> linux/arm64)
PLATFORM=linux/arm64

# Public URLs of the deployed frontend and backend API
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

NEXT_PUBLIC_SELF_HOST=true
NEXT_PUBLIC_PRO_PRICE_MONTHLY=10
NEXT_PUBLIC_SCALE_PRICE_MONTHLY=50
NEXT_PUBLIC_FREE_PLAN_TASK_LIMIT=10
NEXT_PUBLIC_PRO_PLAN_TASK_LIMIT=50
NEXT_PUBLIC_SCALE_PLAN_TASK_LIMIT=300
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_DOMAIN=
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false
